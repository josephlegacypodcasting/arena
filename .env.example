# Where the lead form sits in the flow: first | last | off
NEXT_PUBLIC_GATE_MODE=first

# Booking link on the result page
NEXT_PUBLIC_ARENA_CTA_URL=https://calendly.com/ankita-arenastrategic/30min

# Leave empty to score results with the roadmap's own rules (source: "mock").
# Set it to have Claude write the result (source: "claude").
ANTHROPIC_API_KEY=

# Optional model override
ARENA_MODEL=claude-sonnet-5

# GoHighLevel inbound webhook. Leave empty to only log leads to the server console.
ARENA_LEAD_WEBHOOK_URL=

# Fallbacks used when the landing URL carries no ?lead_source= / ?source_channel=
# and no utm_source / utm_medium.
ARENA_LEAD_SOURCE=AI Readiness Roadmap
ARENA_SOURCE_CHANNEL=Website
